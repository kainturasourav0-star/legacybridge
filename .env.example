# LegacyBridge Environment Configuration Template
# Copy this file to .env.local or .env and populate with your own credentials

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (true for hackathon deterministic mock & zero network failure; false for real APIs)
DEMO_MODE=true

# Server Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEMO_PORTAL_PORT=8080

# Database (PostgreSQL URL for production/Neon/Supabase; SQLite fallback supported)
DATABASE_URL=sqlite+aiosqlite:///./legacybridge.db

# TinyFish Web Agent API (from agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# LangChain / LLM Provider (OpenAI / OpenRouter / Anthropic / Groq / Ollama)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
LLM_MODEL=gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Delivery Adapters
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/SLACK/WEBHOOK
GOOGLE_SHEETS_CREDENTIALS_JSON=
DEFAULT_WEBHOOK_URL=https://webhook.site/mock-target

# App Secret Key for session & credential vault masking
SECRET_KEY=legacy-bridge-super-secret-dev-key-hackathon2026

# Clerk Authentication (Optional in local demo mode, fallback identity used if unconfigured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Supabase PostgreSQL & Storage (Optional in local demo mode, in-memory store used if unconfigured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
