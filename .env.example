# LegacyBridge Environment Configuration

# Demo Mode (true for hackathon deterministic mock & zero network failure; false for real APIs)
DEMO_MODE=true

# Server Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEMO_PORTAL_PORT=8080

# Database (PostgreSQL URL for production/Neon/Supabase; SQLite fallback supported)
DATABASE_URL=sqlite+aiosqlite:///./legacybridge.db

# TinyFish Web Agent API (from agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=tf_live_sample_key_replace_with_yours
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# LangChain / LLM Provider (OpenAI / Anthropic / Groq / Ollama)
OPENAI_API_KEY=sk-sample-openai-key
LLM_MODEL=gpt-4o-mini

# Delivery Adapters
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/SLACK/WEBHOOK
GOOGLE_SHEETS_CREDENTIALS_JSON=
DEFAULT_WEBHOOK_URL=https://webhook.site/mock-target

# App Secret Key for session & credential vault masking
SECRET_KEY=legacy-bridge-super-secret-dev-key-hackathon2026

# Clerk Authentication (Optional in local demo mode, fallback identity used if unconfigured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key

# Supabase PostgreSQL & Storage (Optional in local demo mode, in-memory store used if unconfigured)
NEXT_PUBLIC_SUPABASE_URL=https://sample-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sample-anon-key
SUPABASE_SERVICE_ROLE_KEY=sample-service-role-key

# Intentionally Optional Services (Marked as optional; not required for core execution pipeline)
# RESEND_API_KEY=re_sample_optional_email_key
# POSTHOG_API_KEY=ph_sample_optional_analytics_key
# SENTRY_DSN=https://sample@sentry.io/optional
# OPENROUTER_API_KEY=sk-or-sample_optional_key
# PINECONE_API_KEY=sample_optional_vector_key
# STRIPE_SECRET_KEY=sk_test_sample_optional_key

