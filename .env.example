# LegacyBridge Environment Configuration Template
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (false enables real live APIs; true enables deterministic local mock)
DEMO_MODE=false

# Server Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEMO_PORTAL_PORT=8080

# Database (PostgreSQL URL for production / Supabase / Neon; SQLite fallback supported)
DATABASE_URL=sqlite+aiosqlite:///./legacybridge.db

# TinyFish Web Agent API (from agent.tinyfish.ai)
TINYFISH_API_KEY=sk-tinyfish-your-key-here
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Dual-AI Workflow Orchestration (OpenAI + NVIDIA NIM)
OPENAI_API_KEY=sk-proj-your-openai-key-here
LLM_MODEL=gpt-4o-mini

NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Delivery Adapters
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
GOOGLE_SHEETS_CREDENTIALS_JSON=
DEFAULT_WEBHOOK_URL=https://webhook.site/your-uuid

# App Secret Key for session & credential vault masking
SECRET_KEY=legacy-bridge-super-secret-dev-key-hackathon2026

# Clerk Multi-Tenant Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase PostgreSQL & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...